ASTOR_URL=https://crm.astortech.com.br/entrar?redirectURL=%2F
ASTOR_USER=
ASTOR_PASS=

NOVAVIDA_USER=
NOVAVIDA_PASS=
NOVAVIDA_EMPRESA=
NOVAVIDA_URL=

# NOVAVIDA_CAMPANHA e' usada como fallback quando o robo roda com
# permitir_criar_campanha=False (padrao) - ver Orientacoes_Automacao_AstorTech_NovaVida.txt
NOVAVIDA_CAMPANHA=
NOVAVIDA_SUBCAMPANHA=
NOVAVIDA_PROCESSO=
NOVAVIDA_LAYOUT_ENTRADA=
NOVAVIDA_LAYOUT_SAIDA=

VALOR_MIN=4001.00
VALOR_MAX=8000.99
INTERVALO_HORAS=1

# 06/08/2026: elevado de 6 para 12 apos ciclo real as 11h08 zerar leads - o
# "Data da Consulta" mais recente no export do Astor Tech estava 8h37min
# atrasado em relacao ao horario do ciclo. Reavaliar se o atraso da base do
# Astor Tech mudar (ver .env / config/settings.py).
FILTRO_HORAS_CONSULTA=12

# Envio da base final por e-mail (ver src/notificacao.py). Para
# Gmail/Google Workspace, EMAIL_SENHA precisa ser uma "senha de app"
# (Conta Google -> Seguranca -> Senhas de app), nao a senha normal de
# login - contas com verificacao em duas etapas exigem isso para SMTP.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_REMETENTE=
EMAIL_SENHA=
EMAIL_DESTINATARIO=cs@unicapromotora.com.br
